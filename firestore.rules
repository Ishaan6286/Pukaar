rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // In the new architecture, an NGO is its own authentication entity. 
    // The NGO's UID is the document ID in the 'ngos' collection.
    function isNgoAdmin(ngoId) {
      return isAuthenticated() && 
             request.auth.uid == ngoId &&
             exists(/databases/$(database)/documents/ngos/$(request.auth.uid));
    }
    
    function isAnyNgoAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/ngos/$(request.auth.uid));
    }

    function isSystemAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Users can create/update their own profile
      allow create: if isOwner(userId);
      
      // Prevent privilege escalation
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'trustScore', 'status']);
      allow delete: if isSystemAdmin();
    }
    
    // NGOs Collection
    match /ngos/{ngoId} {
      allow read: if isAuthenticated(); 
      allow create: if isSystemAdmin(); 
      allow update: if isSystemAdmin() || isNgoAdmin(ngoId); 
      allow delete: if isSystemAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSystemAdmin();
      allow create, update, delete: if false; // Managed manually via Firebase console or superadmin scripts
    }
    
    // Reports Collection
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyNgoAdmin() || isSystemAdmin());
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid) || 
        (resource.data.assignedNgoId != null && isNgoAdmin(resource.data.assignedNgoId)) ||
        (resource.data.assignedNgoId == null && isAnyNgoAdmin()) ||
        isSystemAdmin()
      );
      
      allow delete: if isSystemAdmin();
    }
    
    // Timeline Events
    match /timeline_events/{eventId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated(); 
      allow update, delete: if isSystemAdmin(); 
    }

    // Help Locations
    match /help_locations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update: if isAnyNgoAdmin() || isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    // NGO Community Feed Posts
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isNgoAdmin(request.resource.data.ngoId);
      allow update, delete: if isNgoAdmin(resource.data.ngoId) || isSystemAdmin();
    }

    // Post RSVPs / Support
    match /rsvps/{rsvpId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isSystemAdmin();
    }

  }
}

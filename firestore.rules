rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isNgoAdmin(ngoId) {
      return isSignedIn()
        && userRole() == 'ngo_admin'
        && request.auth.uid in get(/databases/$(database)/documents/ngos/$(ngoId)).data.adminUids;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /ngos/{ngoId} {
      allow read: if true;
      allow write: if false;

      match /incoming_reports/{reportId} {
        allow read, update: if isNgoAdmin(ngoId);
        allow create: if isSignedIn()
          && request.resource.data.reporterUid == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.reporterUid == request.auth.uid
            || (resource.data.ngoId != null && isNgoAdmin(resource.data.ngoId)));
      allow update: if isSignedIn()
        && (resource.data.reporterUid == request.auth.uid
            || (resource.data.ngoId != null && isNgoAdmin(resource.data.ngoId)));
    }

    match /help_locations/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && userRole() == 'ngo_admin'
        && isNgoAdmin(request.resource.data.ngoId);
      allow update, delete: if isSignedIn() && isNgoAdmin(resource.data.ngoId);

      match /rsvps/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
